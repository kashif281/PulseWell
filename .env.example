# Runtime
NODE_ENV="development"

# Database
DATABASE_URL="postgresql://pulseai:pulseai_dev@localhost:5433/pulseai?schema=public"

# Generate secrets; never reuse these examples in production.
# Example: openssl rand -base64 48
JWT_SECRET=""
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET=""
JWT_REFRESH_EXPIRES_IN="7d"

# 32-byte key used for AES-256-GCM field encryption.
# Generate once with: openssl rand -base64 32
# Back it up securely; losing it makes encrypted data unrecoverable.
DATA_ENCRYPTION_KEY=""

# OpenAI (optional fallback)
OPENAI_API_KEY=""

# Google Gemini (preferred for chat when set)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# AWS S3 (optional for MVP - local fallback available)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="nura-documents"

# App
API_PORT=5002
NEXT_PUBLIC_API_URL="/api/v1"
FRONTEND_URL="http://localhost:4000"
WEB_PORT=4000

# Super Admin seed
SUPER_ADMIN_EMAIL="superadmin@nura.app"
SUPER_ADMIN_PASSWORD=""

# Demo accounts (npm run db:seed)
DEMO_ADMIN_EMAIL="admin@acme.com"
DEMO_ADMIN_PASSWORD=""
DEMO_EMPLOYEE_EMAIL="employee@acme.com"
DEMO_EMPLOYEE2_EMAIL="john@acme.com"
DEMO_EMPLOYEE_PASSWORD=""

# Transactional email
# Prefer BREVO_API_KEY (HTTP API, port 443) over SMTP: many hosts (Railway, etc.)
# block outbound SMTP ports 25/465/587, which makes SMTP hang until timeout.
# Get it from Brevo: Settings -> SMTP & API -> API keys & MCP -> Generate a new API key.
BREVO_API_KEY=""
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@nura.app"
EMAIL_FROM_NAME="Nura HR"
EMAIL_MESSAGE_DOMAIN="mail.nura.app"
EMAIL_REPLY_DOMAIN=""
EMAIL_WEBHOOK_SECRET=""
