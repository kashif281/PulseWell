enum AssetCategory {
  LAPTOP
  DESKTOP
  MONITOR
  KEYBOARD
  MOUSE
  HEADSET
  MOBILE_PHONE
  TABLET
  SIM_CARD
  ACCESS_CARD
  SECURITY_TOKEN
  DOCKING_STATION
  CHARGER
  BACKPACK
  COMPANY_VEHICLE
  OTHER
}

enum AssetCondition {
  NEW
  GOOD
  DAMAGED
  UNDER_REPAIR
  LOST
  RETIRED
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  IN_REPAIR
  RETIRED
}

enum AssetIssueType {
  DAMAGE
  REPAIR
  LOSS
  REPLACEMENT
}

enum AssetIssueStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum AssetAuditAction {
  CREATED
  ASSIGNED
  RETURNED
  REPAIRED
  WARRANTY_UPDATED
  EMPLOYEE_CHANGED
  STATUS_CHANGED
  LOST_REPORTED
  ARCHIVED
  ISSUE_REPORTED
}

model Asset {
  id              String         @id @default(cuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assetTag        String
  barcode         String?
  serialNumber    String?
  name            String
  category        AssetCategory
  brand           String?
  model           String?
  purchaseDate    DateTime?      @db.Date
  purchasePrice   Decimal?       @db.Decimal(12, 2)
  warrantyExpiry  DateTime?      @db.Date
  vendor          String?
  condition       AssetCondition @default(NEW)
  status          AssetStatus    @default(AVAILABLE)
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  assignments     AssetAssignment[]
  auditLogs       AssetAuditLog[]
  issueReports    AssetIssueReport[]

  @@unique([companyId, assetTag])
  @@index([companyId, status])
  @@map("assets")
}

model AssetAssignment {
  id                    String         @id @default(cuid())
  assetId               String
  asset                 Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employeeId            String
  employee              Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignedAt            DateTime       @default(now())
  expectedReturnAt      DateTime?      @db.Date
  returnedAt            DateTime?
  conditionAtAssignment AssetCondition
  conditionAtReturn     AssetCondition?
  notes                 String?
  missingAccessories    String?
  damageNotes           String?
  assignedById          String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([assetId])
  @@index([employeeId])
  @@map("asset_assignments")
}

model AssetAuditLog {
  id            String           @id @default(cuid())
  assetId       String
  asset         Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId        String?
  action        AssetAuditAction
  previousValue Json?
  newValue      Json?
  reason        String?
  createdAt     DateTime         @default(now())

  @@index([assetId])
  @@map("asset_audit_logs")
}

model AssetIssueReport {
  id          String           @id @default(cuid())
  assetId     String
  asset       Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        AssetIssueType
  description String
  status      AssetIssueStatus @default(PENDING)
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([assetId])
  @@index([employeeId])
  @@map("asset_issue_reports")
}

enum LearningTrack {
  ENGINEERING
  FINANCE
  HR
  MARKETING
  SALES
  GENERAL
}

enum LearningDifficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

enum LearningProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum MockInterviewType {
  FRONTEND
  BACKEND
  FULL_STACK
  DEVOPS
  DSA
  SYSTEM_DESIGN
  BEHAVIORAL
}

model Skill {
  id          String   @id @default(cuid())
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  category    String
  description String?
  track       LearningTrack @default(GENERAL)
  createdAt   DateTime @default(now())

  employeeSkills EmployeeSkill[]

  @@unique([companyId, name])
  @@index([track])
  @@map("skills")
}

model EmployeeSkill {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skillId    String
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  rating     Int      @default(1)
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, skillId])
  @@index([employeeId])
  @@map("employee_skills")
}

model LearningPath {
  id          String        @id @default(cuid())
  companyId   String?
  company     Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  description String?
  track       LearningTrack @default(GENERAL)
  sortOrder   Int           @default(0)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())

  modules  LearningModule[]
  progress LearningProgress[]

  @@index([companyId, track])
  @@map("learning_paths")
}

model LearningModule {
  id          String       @id @default(cuid())
  pathId      String
  path        LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  title       String
  summary     String?
  content     String?      @db.Text
  sortOrder   Int          @default(0)
  durationMin Int          @default(30)
  createdAt   DateTime     @default(now())

  progress LearningProgress[]

  @@index([pathId])
  @@map("learning_modules")
}

model LearningProgress {
  id           String                 @id @default(cuid())
  employeeId   String
  employee     Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  pathId       String?
  path         LearningPath?          @relation(fields: [pathId], references: [id], onDelete: Cascade)
  moduleId     String?
  module       LearningModule?        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  status       LearningProgressStatus @default(NOT_STARTED)
  timeSpentMin Int                    @default(0)
  completedAt  DateTime?
  updatedAt    DateTime               @updatedAt

  @@unique([employeeId, moduleId])
  @@index([employeeId])
  @@map("learning_progress")
}

model QuizSession {
