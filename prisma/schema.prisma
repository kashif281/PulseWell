generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  MANAGER
  EMPLOYEE
}

enum SubscriptionPlan {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  TRIAL
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum SmokingStatus {
  NEVER
  FORMER
  CURRENT
  OCCASIONAL
}

enum AlcoholConsumption {
  NONE
  OCCASIONAL
  MODERATE
  HEAVY
}

enum ExerciseFrequency {
  NONE
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum MoodLevel {
  VERY_LOW
  LOW
  NEUTRAL
  GOOD
  EXCELLENT
}

enum StressLevel {
  VERY_LOW
  LOW
  MODERATE
  HIGH
  VERY_HIGH
}

enum EnergyLevel {
  VERY_LOW
  LOW
  MODERATE
  HIGH
  VERY_HIGH
}

enum MetricType {
  WEIGHT
  BMI
  SLEEP
  WATER_INTAKE
  EXERCISE_MINUTES
  CALORIES
  HEART_RATE
  BLOOD_PRESSURE_SYSTOLIC
  BLOOD_PRESSURE_DIASTOLIC
  BLOOD_SUGAR
  MOOD
  STRESS
  ENERGY
  MEDICATION
  SMOKING
  ALCOHOL
}

enum ExpenseCategory {
  INSURANCE
  GYM_MEMBERSHIP
  MENTAL_HEALTH
  MEDICAL_CLAIMS
  DOCTOR_VISITS
  VACCINATIONS
  WELLNESS_BUDGET
  EQUIPMENT
  BENEFITS
  PAYROLL
  OFFICE
  TRAVEL
  TRAINING
  BONUSES
  WELLNESS
  RECRUITMENT
  OTHER
}

enum DocumentType {
  BLOOD_TEST
  MEDICAL_REPORT
  PRESCRIPTION
  INSURANCE_CARD
  VACCINATION_RECORD
  LEARNING_MATERIAL
  TUTORIAL
  OTHER
}

enum NotificationType {
  MORNING_CHECKIN
  WATER_REMINDER
  EXERCISE_REMINDER
  MEDICINE_REMINDER
  SLEEP_REMINDER
  WEEKLY_SUMMARY
  MONTHLY_REPORT
  GENERAL
  SALARY_GENERATED
  SALARY_PAID
  LEAVE_APPROVED
  LEAVE_REJECTED
  LOAN_APPROVED
  ATTENDANCE_REMINDER
  HEALTH_REMINDER
  AI_RECOMMENDATION
  WEATHER_ALERT
  EMAIL_REPLY
  EMAIL_BOUNCE
}

enum ActivityType {
  CHECK_IN
  CHAT
  WEIGHT_UPDATE
  EXERCISE
  REPORT_UPLOADED
  MEDICINE_LOGGED
  GOAL_COMPLETED
  ACHIEVEMENT_EARNED
  PROFILE_UPDATE
  ATTENDANCE_CHECK_IN
  ATTENDANCE_CHECK_OUT
  LEAVE_REQUESTED
  LEAVE_APPROVED
  PAYROLL_GENERATED
  EMAIL_SENT
  EMAIL_RECEIVED
}

enum EmailThreadStatus {
  OPEN
  ARCHIVED
}

enum EmailSenderType {
  HR
  EMPLOYEE
  SYSTEM
}

enum EmailDirection {
  OUTBOUND
  INBOUND
}

enum ReportType {
  MONTHLY
  QUARTERLY
  ANNUAL
  DEPARTMENT
  SPENDING
  WELLNESS
  HEALTH_TRENDS
}

enum ReportFormat {
  PDF
  EXCEL
  CSV
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  OTHER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum EmploymentStatus {
  INVITATION_PENDING
  INVITATION_SENT
  INVITATION_EXPIRED
  ACTIVE
  INACTIVE
  PROBATION
  SUSPENDED
  NOTICE_PERIOD
  RESIGNED
  TERMINATED
}

enum PayrollType {
  MONTHLY
  HOURLY
  CONTRACT
}

enum PaymentFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  REMOTE
  ON_LEAVE
  HALF_DAY
}

enum LiveAttendanceStatus {
  WORKING
  ON_BREAK
  CHECKED_OUT
  ABSENT
  ON_LEAVE
  REMOTE
}

enum PresenceVisibility {
  COMPANY
  DEPARTMENT
  TEAM
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum HalfDayType {
  FIRST_HALF
  SECOND_HALF
}

enum PayrollStatus {
  DRAFT
  GENERATED
  APPROVED
  PAID
  CANCELLED
}

enum LoanStatus {
  ACTIVE
  PAID
  CANCELLED
}

enum SalaryPaymentStatus {
  PENDING
  PROCESSING
  PAID
}

enum AllowanceType {
  TRANSPORT
  MEDICAL
  INTERNET
  FUEL
  HOUSING
  MEAL
  CUSTOM
}

enum DeductionType {
  TAX
  LOAN
  ADVANCE_SALARY
  LATE_ARRIVAL
  UNPAID_LEAVE
  INSURANCE
  CUSTOM
}

enum ApprovalType {
  LEAVE
  LOAN
  PAYROLL
  DOCUMENT
  PROFILE_UPDATE
  EXPENSE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum HrReportType {
  ATTENDANCE
  LEAVE
  PAYROLL
  HEALTH
  INSURANCE_SPENDING
  DEPARTMENT_ANALYTICS
  LATE_EMPLOYEES
  OVERTIME
  SALARY_COST
  MEDICAL_COST
  WELLNESS_TRENDS
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String?
  firstName         String?
  lastName          String?
  role              UserRole  @default(EMPLOYEE)
  emailVerified     Boolean   @default(false)
  emailVerifyToken  String?
  resetToken        String?
  resetTokenExpiry  DateTime?
  googleId          String?   @unique
  microsoftId       String?   @unique
  avatarUrl         String?
  isActive          Boolean   @default(true)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  companyId         String?
  company           Company?  @relation(fields: [companyId], references: [id])
  employee          Employee?
  refreshTokens     RefreshToken[]
  chatSessions      ChatSession[]
  notifications     Notification[]
  activityLogs      ActivityLog[]
  documents         Document[]
  reports           Report[]

  @@index([companyId])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Company {
  id                String   @id @default(cuid())
  name              String
  industry          String?
  country           String?
  timezone          String   @default("UTC")
  employeeCount     Int      @default(0)
  insuranceProvider String?
  healthcareBudget  Decimal? @db.Decimal(12, 2)
  workingDays       String[] @default(["MON", "TUE", "WED", "THU", "FRI"])
  businessHoursStart String? @default("09:00")
  businessHoursEnd   String? @default("17:00")
  presenceVisibility PresenceVisibility @default(COMPANY)
  logoUrl           String?
  officeAddress     String?
  officeCity        String?
  officeLatitude    Float?
  officeLongitude   Float?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users             User[]
  employees         Employee[]
  departments       Department[]
  expenses          Expense[]
  subscriptions     Subscription[]
  wellnessConfig    WellnessScoreConfig?
  leaveTypes        LeaveType[]
  holidays          Holiday[]
  payrolls          Payroll[]
  companyActivities CompanyActivity[]
  weatherSettings   WeatherSettings?
  weatherAlerts     WeatherAlert[]
  weatherRecommendations WeatherRecommendation[]
  assets            Asset[]
  policies          CompanyPolicy[]
  skills            Skill[]
  learningPaths     LearningPath[]
  codingChallenges  CodingChallenge[]
  certifications    Certification[]
  learningMaterials LearningMaterial[]
  emailThreads      EmailThread[]
  emailTemplates    EmailTemplate[]
  integrations      CompanyIntegration[]

  @@map("companies")
}

model Subscription {
  id        String             @id @default(cuid())
  companyId String
  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan   @default(FREE)
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([companyId])
  @@map("subscriptions")
}

model Department {
  id        String   @id @default(cuid())
  name      String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("departments")
}

model Employee {
  id                 String             @id @default(cuid())
  employeeNumber     String?
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId          String
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentId       String?
  department         Department?        @relation(fields: [departmentId], references: [id])
  managerId          String?
  manager            Employee?          @relation("EmployeeManager", fields: [managerId], references: [id])
  directReports      Employee[]         @relation("EmployeeManager")
  position           String?
  team               String?
  gender             Gender?
  age                Int?
  dateOfBirth        DateTime?          @db.Date
  phoneNumber        String?
  nationality        String?
  maritalStatus      MaritalStatus?
  height             Float?
  weight             Float?
  bloodGroup         String?
  emergencyContact   String?
  emergencyPhone     String?
  address            String?
  city               String?
  homeCountry        String?
  latitude           Float?
  longitude          Float?
  commuteDistanceKm  Float?
  commuteDurationMin Int?
  allergies          String[]
  existingConditions String[]
  smokingStatus      SmokingStatus?
  alcoholConsumption AlcoholConsumption?
  exerciseFrequency  ExerciseFrequency?
  joiningDate        DateTime?          @db.Date
  employmentType     EmploymentType?    @default(FULL_TIME)
  employmentStatus   EmploymentStatus?  @default(ACTIVE)
  baseSalary         Decimal?           @db.Decimal(12, 2)
  hourlySalary       Decimal?           @db.Decimal(10, 2)
  payrollType        PayrollType?       @default(MONTHLY)
  paymentFrequency   PaymentFrequency?  @default(MONTHLY)
  bankName           String?
  accountNumber      String?
  taxNumber          String?
  currency           String?            @default("USD")
  onboardingComplete Boolean            @default(false)
  invitationToken        String?            @unique
  invitationExpiresAt    DateTime?
  invitationSentAt       DateTime?
  lastInvitationEmailAt  DateTime?
  invitationAcceptedAt   DateTime?
  termsAcceptedAt        DateTime?
  privacyAcceptedAt      DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  healthCheckins     HealthCheckin[]
  healthMetrics      HealthMetric[]
  goals              Goal[]
  achievements       Achievement[]
  wellnessScores     WellnessScore[]
  attendances        Attendance[]
  leaveBalances      LeaveBalance[]
  leaveRequests      LeaveRequest[]
  salaryStructure    SalaryStructure?
  payrollItems       PayrollItem[]
  loans              EmployeeLoan[]
  salaryPayments     SalaryPayment[]
  bankAccounts       BankAccount[]
  approvalRequests   ApprovalRequest[]
  companyActivities  CompanyActivity[]
  weatherAlerts      WeatherAlert[]
  assetAssignments   AssetAssignment[]
  assetIssueReports  AssetIssueReport[]
  employeeSkills     EmployeeSkill[]
  learningProgress   LearningProgress[]
  quizSessions       QuizSession[]
  codingSubmissions  CodingSubmission[]
  certifications     EmployeeCertification[]
  emailThreads       EmailThread[]

  @@unique([companyId, employeeNumber])
  @@index([companyId])
  @@index([departmentId])
  @@map("employees")
}

model HealthCheckin {
  id              String       @id @default(cuid())
  employeeId      String
  employee        Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date            DateTime     @db.Date
  sleepHours      Float?
  mood            MoodLevel?
  energy          EnergyLevel?
  stress          StressLevel?
  exerciseMinutes Int?
  waterIntake     Float?
  mealsCount      Int?
  painLevel       Int?
  symptoms        String[]
  medicineTaken   Boolean      @default(false)
  medicineNotes   String?
  weight          Float?
  notes           String?
  healthScore     Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@map("health_checkins")
}

model HealthMetric {
  id         String     @id @default(cuid())
  employeeId String
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       MetricType
  value      Float
  unit       String?
  recordedAt DateTime   @default(now())
  notes      String?
  createdAt  DateTime   @default(now())

  @@index([employeeId, type])
  @@index([recordedAt])
  @@map("health_metrics")
}

model WellnessScoreConfig {
  id              String  @id @default(cuid())
  companyId       String  @unique
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sleepWeight     Float   @default(0.2)
  exerciseWeight  Float   @default(0.2)
  stressWeight    Float   @default(0.2)
  nutritionWeight Float   @default(0.2)
  hydrationWeight Float   @default(0.2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("wellness_score_configs")
}

model WellnessScore {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date            DateTime @db.Date
  overallScore    Int
  sleepScore      Int?
  exerciseScore   Int?
  stressScore     Int?
  nutritionScore  Int?
  hydrationScore  Int?
  createdAt       DateTime @default(now())

  @@unique([employeeId, date])
  @@index([employeeId])
  @@map("wellness_scores")
}

model ChatSession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentType AgentType @default(WELLNESS)
  title     String?
  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  messages  Message[]

  @@index([userId, agentType])
  @@map("chat_sessions")
}

model Message {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  embedding Unsupported("vector(1536)")?
  createdAt DateTime    @default(now())

  @@index([sessionId])
  @@map("messages")
}

model Goal {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title       String
  description String?
  targetValue Float?
  currentValue Float    @default(0)
  unit        String?
  deadline    DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([employeeId])
  @@map("goals")
}

model Achievement {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title       String
  description String?
  icon        String?
  earnedAt    DateTime @default(now())

  @@index([employeeId])
  @@map("achievements")
}

model Expense {
  id          String          @id @default(cuid())
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  description String?
  department  String?
  employeeId  String?
  date        DateTime        @db.Date
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([companyId])
  @@index([date])
  @@map("expenses")
}

model Report {
  id        String       @id @default(cuid())
  companyId String?
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  type      ReportType
  format    ReportFormat
  title     String
  fileUrl   String?
  metadata  Json?
  createdAt DateTime     @default(now())

  @@index([companyId])
  @@map("reports")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  sentAt    DateTime         @default(now())
  readAt    DateTime?

  @@index([userId])
  @@map("notifications")
}

model Document {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      DocumentType
  fileName  String
  fileUrl   String
  fileSize  Int?
  mimeType  String?
  analysisSummary Json?
  createdAt DateTime     @default(now())

  @@index([userId])
  @@map("documents")
}

model ActivityLog {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        ActivityType
  title       String
  description String?
  metadata    Json?
  createdAt   DateTime     @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}

model AiInsight {
  id         String   @id @default(cuid())
  employeeId String?
  companyId  String?
  scope      String
  title      String
  content    String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([employeeId])
  @@index([companyId])
  @@map("ai_insights")
}

model Attendance {
  id                    String                @id @default(cuid())
  employeeId            String
  employee              Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date                  DateTime              @db.Date
  checkInAt             DateTime?
  checkOutAt            DateTime?
  firstCheckInAt        DateTime?
  lastCheckOutAt        DateTime?
  status                AttendanceStatus      @default(PRESENT)
  liveStatus            LiveAttendanceStatus?
  isRemote              Boolean               @default(false)
  workingHours          Float?
  overtimeHours         Float?
  totalBreakMinutes     Int                   @default(0)
  sessionCount          Int                   @default(0)
  lateMinutes           Int?
  earlyDepartureMinutes Int?
  dayEndedAt            DateTime?
  missingCheckOut       Boolean               @default(false)
  notes                 String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  logs                  AttendanceLog[]
  sessions              AttendanceSession[]

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@map("attendance")
}

model AttendanceSession {
  id            String     @id @default(cuid())
  attendanceId  String
  attendance    Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  sessionNumber Int
  checkInAt     DateTime
  checkOutAt    DateTime?
  isRemote      Boolean    @default(false)
  workingHours  Float?
  createdAt     DateTime   @default(now())

  @@index([attendanceId])
  @@map("attendance_sessions")
}

model CompanyActivity {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  type       String
  message    String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt])
  @@map("company_activities")
}

model AttendanceLog {
  id           String     @id @default(cuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  action       String
  timestamp    DateTime   @default(now())
  metadata     Json?

  @@index([attendanceId])
  @@map("attendance_logs")
}

model LeaveType {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  code         String
  daysPerYear  Int      @default(0)
  isPaid       Boolean  @default(true)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  balances     LeaveBalance[]
  requests     LeaveRequest[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("leave_types")
}

model LeaveBalance {
  id           String    @id @default(cuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId  String
  leaveType    LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  year         Int
  allocated    Float     @default(0)
  used         Float     @default(0)
  remaining    Float     @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId])
  @@map("leave_balances")
}

model LeaveRequest {
  id               String             @id @default(cuid())
  employeeId       String
  employee         Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId      String
  leaveType        LeaveType          @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  startDate        DateTime           @db.Date
  endDate          DateTime           @db.Date
  isHalfDay        Boolean            @default(false)
  halfDayType      HalfDayType?
  reason           String?
  attachmentUrl    String?
  emergencyContact String?
  status           LeaveRequestStatus @default(PENDING)
  managerApproved  Boolean?
  managerApprovedAt DateTime?
  hrApprovedAt     DateTime?
  rejectedReason   String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([employeeId])
  @@index([status])
  @@map("leave_requests")
}

model SalaryStructure {
  id          String   @id @default(cuid())
  employeeId  String   @unique
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  baseSalary  Decimal  @db.Decimal(12, 2)
  allowances  Json     @default("[]")
  deductions  Json     @default("[]")
  currency    String   @default("USD")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("salary_structures")
}

model Payroll {
  id          String        @id @default(cuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  periodStart DateTime      @db.Date
  periodEnd   DateTime      @db.Date
  status      PayrollStatus @default(DRAFT)
  totalGross  Decimal       @default(0) @db.Decimal(14, 2)
  totalNet    Decimal       @default(0) @db.Decimal(14, 2)
  generatedAt DateTime?
  approvedAt  DateTime?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  items       PayrollItem[]

  @@index([companyId])
  @@map("payrolls")
}

model PayrollItem {
  id              String   @id @default(cuid())
  payrollId       String
  payroll         Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  baseSalary      Decimal  @db.Decimal(12, 2)
  totalAllowances Decimal  @default(0) @db.Decimal(12, 2)
  totalBonuses    Decimal  @default(0) @db.Decimal(12, 2)
  overtimePay     Decimal  @default(0) @db.Decimal(12, 2)
  totalDeductions Decimal  @default(0) @db.Decimal(12, 2)
  tax             Decimal  @default(0) @db.Decimal(12, 2)
  loanDeduction   Decimal  @default(0) @db.Decimal(12, 2)
  latePenalty     Decimal  @default(0) @db.Decimal(12, 2)
  leaveDeduction  Decimal  @default(0) @db.Decimal(12, 2)
  netSalary       Decimal  @db.Decimal(12, 2)
  breakdown       Json?
  createdAt       DateTime @default(now())

  salaryPayment   SalaryPayment?

  @@unique([payrollId, employeeId])
  @@index([payrollId])
  @@index([employeeId])
  @@map("payroll_items")
}

model EmployeeLoan {
